# 文件描述：本机BBT单点登录的环境变量模板。
# 项目名称：Headlamp BBT
# 文件名称：.env.bbt-sso.example
# 作者：Codex
# 日期：2026-11-19
HEADLAMP_CONFIG_OIDC_CLIENT_ID=
HEADLAMP_CONFIG_OIDC_CLIENT_SECRET=
HEADLAMP_CONFIG_OIDC_IDP_ISSUER_URL=https://rancher.bbt.sspu.edu.cn/oidc
HEADLAMP_CONFIG_RANCHER_URL=https://rancher.bbt.sspu.edu.cn
HEADLAMP_CONFIG_OIDC_CALLBACK_URL=http://localhost:4466/oidc-callback
HEADLAMP_CONFIG_IN_CLUSTER_CONTEXT_NAME=bbt-sso
HEADLAMP_CONFIG_SESSION_TTL=86400
HEADLAMP_CONFIG_OIDC_SCOPES=profile,offline_access
HEADLAMP_CONFIG_OIDC_USE_COOKIE=true
HEADLAMP_CONFIG_OIDC_USE_ACCESS_TOKEN=true
HEADLAMP_CONFIG_OIDC_USE_PKCE=true
HEADLAMP_CONFIG_OIDC_CA_FILE=
