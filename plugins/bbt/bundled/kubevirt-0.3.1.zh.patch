diff --git a/localized/src/i18n.ts b/localized/src/i18n.ts
new file mode 100644
index 0000000..22a7378
--- /dev/null
+++ b/localized/src/i18n.ts
@@ -0,0 +1,28 @@
+// 文件描述：连接 Headlamp 的插件语言包与当前界面语言。
+// 项目名：Headlamp KubeVirt
+// 文件名：i18n.ts
+// 作者：Qintsg
+// 日期：2026-11-07
+
+import { useTranslation } from '@kinvolk/headlamp-plugin/lib';
+import type { TOptions } from 'i18next';
+import { useMemo } from 'react';
+
+const englishKey = ((key: string) => key) as ReturnType<typeof useTranslation>['t'];
+
+/**
+ * 获取 KubeVirt 插件的翻译函数和语言状态。
+ *
+ * :returns: Headlamp 提供的插件翻译状态。
+ */
+export function useKubeVirtTranslation() {
+  const { i18n, ready } = useTranslation('kubevirt');
+  const language = i18n?.language;
+  const t = useMemo(() => {
+    if (!i18n || !language) return englishKey;
+    const fixedT = i18n.getFixedT(language);
+    return ((key: string, options?: TOptions) =>
+      fixedT(key, { ...options, nsSeparator: false, keySeparator: false })) as typeof englishKey;
+  }, [i18n, language]);
+  return { t, i18n, ready };
+}
