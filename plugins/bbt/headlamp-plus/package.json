{
  "name": "headlamp-plus",
  "version": "0.2.0",
  "description": "Headlamp Plus: light and dark themes and dashboards with usage trends for clusters, workloads and namespaces",
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "theme",
    "dashboard"
  ],
  "homepage": "https://github.com/batuhancikrikci/headlamp-plugins/tree/main/headlamp-plus#readme",
  "bugs": {
    "url": "https://github.com/batuhancikrikci/headlamp-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batuhancikrikci/headlamp-plugins.git",
    "directory": "headlamp-plus"
  },
  "license": "Apache-2.0",
  "author": "Batuhan CIKRIKCI",
  "origin": "headlamp-plugins",
  "engines": {
    "node": ">=20.11.1",
    "npm": ">=10.0.0"
  },
  "headlamp": {
    "minVersion": "0.45.0",
    "i18n": ["zh", "zh-x-bbt"],
    "extraDist": {
      "LICENSE": "LICENSE",
      "NOTICE": "NOTICE"
    }
  },
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "start": "npm run icons && headlamp-plugin start",
    "build": "npm run icons && headlamp-plugin build && node scripts/stage.mjs",
    "package": "npm run build && headlamp-plugin package",
    "check": "npm run format:check && npm run tsc && npm run lint && npm run check:locales && npm test",
    "check:locales": "node scripts/check-locales.cjs",
    "format:check": "prettier --check src scripts locales README.md",
    "tsc": "tsc --noEmit",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "format": "headlamp-plugin format",
    "test": "vitest run -c node_modules/@kinvolk/headlamp-plugin/config/vite.config.mjs",
    "storybook": "npm run icons && headlamp-plugin storybook",
    "storybook-build": "npm run icons && headlamp-plugin storybook-build"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@kinvolk/headlamp-plugin": "^0.14.0",
    "@types/js-yaml": "^4.0.9"
  },
  "overrides": {
    "typescript": "5.6.2",
    "vitest": "^3.2.7",
    "@vitest/coverage-istanbul": "^3.2.7"
  },
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  }
}
